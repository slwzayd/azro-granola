# =============================================================================
#  OMGEVINGSVARIABELEN — voorbeeldbestand
# =============================================================================
#  Kopieer dit bestand naar ".env" en vul je eigen sleutels in.
#  Het bestand ".env" staat in .gitignore en mag NOOIT in git terechtkomen.
#  Op Netlify vul je dezelfde waarden in bij Site settings → Environment variables.
# =============================================================================

# --- Mollie ------------------------------------------------------------------
# Testen doe je met de sleutel die begint met test_
# Pas als alles werkt, zet je hier (in Netlify) de live_ sleutel.
MOLLIE_API_KEY=test_vervang_dit_door_je_eigen_testsleutel

# --- E-mail versturen (Resend — gratis plan) ---------------------------------
# Maak een account op https://resend.com en maak een API-sleutel aan.
RESEND_API_KEY=re_vervang_dit

# Het adres waar de bestellingen naartoe gaan (jij dus).
EIGENAAR_EMAIL=jouw.adres@voorbeeld.be

# Afzender van de e-mails.
# Om te testen mag je onderstaande waarde laten staan.
# Voor een eigen afzender moet je eerst je domein verifiëren bij Resend.
AFZENDER_EMAIL=Azro granola <onboarding@resend.dev>
